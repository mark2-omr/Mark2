@using Microsoft.Extensions.Localization

@inject IStringLocalizer<Mark2.Pages.Index> Loc

<div class="defrag">
    <div class="defrag-header">
        @if (IsCompleted && Stopwatch?.IsRunning == false)
        {
            <span class="defrag-counter">@Stopwatch.Elapsed.TotalSeconds.ToString("F3") @Loc["Seconds"]</span>
        }
        <span class="defrag-counter defrag-progress">@Percent% (@Processed/@Total)</span>
    </div>
    <div class="defrag-map" style="--defrag-cell-size: @(CellSize)px;">
        @for (int i = 0; i < Total; i++)
        {
            <div class="@CellClass(i)"></div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int Total { get; set; }

    [Parameter]
    public int Processed { get; set; }

    [Parameter]
    public bool IsCompleted { get; set; }

    // Its elapsed time is shown once recognition completes.
    [Parameter]
    public System.Diagnostics.Stopwatch? Stopwatch { get; set; }

    private int Percent => Total > 0 ? Processed * 100 / Total : 0;

    // One cell represents one image, so the cells shrink as the number of images grows.
    private int CellSize => Total switch
    {
        <= 400 => 14,
        <= 1500 => 9,
        _ => 6,
    };

    // Before recognition starts, every cell stays pending.
    private bool IsActive(int cell) => Stopwatch?.IsRunning == true && cell == Processed;

    private string CellClass(int cell)
    {
        if (IsCompleted || cell < Processed)
        {
            return "defrag-cell defrag-cell-done";
        }
        if (IsActive(cell))
        {
            return "defrag-cell defrag-cell-active";
        }
        return "defrag-cell defrag-cell-pending";
    }
}
