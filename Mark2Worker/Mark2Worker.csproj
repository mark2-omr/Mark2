<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- ImageSharp validates the license per project. Without SixLaborsLicenseKey, use the local license of the app. -->
  <PropertyGroup Condition="'$(SixLaborsLicenseKey)' == '' and '$(SixLaborsLicenseFile)' == '' and Exists('..\Mark2\sixlabors.lic')">
    <SixLaborsLicenseFile>..\Mark2\sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
  </ItemGroup>

</Project>
